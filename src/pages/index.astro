---
import SiteLayout from "../layouts/SiteLayout.astro";
import RecipeBrowser from "../components/RecipeBrowser";
import MealCard from "../components/MealCard.astro";
import Icon from "../components/Icon";
import { greeting, loadKitchen, viewerToday } from "../lib/server/page";
import { mealImages, recipeCard } from "../lib/format";
import { emptyPlan, entryCount, mondayOf, planIdFor } from "../lib/plans";
import { WEEKDAYS, formatRange, fromIso } from "../lib/dates";

const { library, planning, owner, viewer, recipesById, mealsById } = await loadKitchen(Astro.locals);
const today = viewerToday(Astro.locals);
const monday = mondayOf(today);
const week = planning.plans.find((p) => p.id === planIdFor(monday)) ?? emptyPlan(monday);
const planned = entryCount(week);
const onList = planning.shopping.dishes.length + planning.shopping.items.length;
const range = formatRange(week.days[0].date, week.days[6].date);

const firstName = viewer.name?.trim().split(/\s+/)[0];
const hello = `${greeting(Astro.locals)}${firstName ? `, ${firstName}` : ""}`;
// The shell's Overview: the day, then one line of what matters.
const summary = [
  fromIso(today).toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" }),
  planned > 0 ? `${planned} ${planned === 1 ? "dish" : "dishes"} planned this week` : null,
  onList > 0 ? `${onList} on your shopping list` : null,
]
  .filter(Boolean)
  .join(" · ");

// Newest first, so something just added shows up on the home page.
const latest = [...library.recipes]
  .sort((a, b) => (b.updatedAt ?? "").localeCompare(a.updatedAt ?? ""))
  .slice(0, 8)
  .map(recipeCard);

const dishFor = (entry: (typeof week.days)[number]["entries"][number]) => {
  if (entry.mealId) {
    const meal = mealsById.get(entry.mealId);
    return meal
      ? { title: meal.name, href: `/meals/${meal.id}`, image: mealImages(meal, recipesById)[0] }
      : null;
  }
  const recipe = entry.recipeId ? recipesById.get(entry.recipeId) : undefined;
  return recipe ? { title: recipe.title, href: `/recipes/${recipe.id}`, image: recipe.image } : null;
};
---

<SiteLayout title="Hestia">
  <div class="as-main">
    <header class="as-head">
      <div>
        <h1>{hello}</h1>
        <p>{summary}</p>
      </div>
      <div class="as-head-end">
        <a class="btn" href="/shopping">
          <Icon name="bag" /> Shopping list
          {onList > 0 && <span class="count-badge">{onList}</span>}
        </a>
        <a class="btn btn-primary" href="/plan"><Icon name="calendar" /> Plan the week</a>
      </div>
    </header>

    <form class="search as-tools" action="/recipes" method="get" role="search" style="max-width: 520px;">
      <Icon name="search" />
      <input class="input" type="search" name="q" placeholder="Search recipes…" aria-label="Search recipes" />
    </form>

    <section class="as-card as-pad">
      <div class="as-card-h">
        <h2>This week</h2>
        <a href="/plan">Open the planner <Icon name="arrowRight" /></a>
      </div>
      {
        planned === 0 ? (
          <div class="as-empty">
            <p>Nothing planned for {range} yet.</p>
            <a class="btn btn-primary" href="/plan">
              <Icon name="calendar" /> Plan the week
            </a>
          </div>
        ) : (
          <div class="week-strip">
            {week.days.map((day) => (
              <div class={day.date === today ? "week-day is-today" : "week-day"}>
                <span class="week-day-name">
                  {WEEKDAYS[fromIso(day.date).getDay()]} {fromIso(day.date).getDate()}
                  {day.date === today && " · Today"}
                </span>
                {day.entries.length === 0 && <span class="small muted">—</span>}
                {day.entries.map((entry) => {
                  const dish = dishFor(entry);
                  return dish ? (
                    <a class="week-dish" href={dish.href}>
                      {dish.image ? <img src={dish.image} alt="" loading="lazy" /> : <span class="thumb-empty" />}
                      {dish.title}
                    </a>
                  ) : null;
                })}
              </div>
            ))}
          </div>
        )
      }
    </section>

    <div class="as-sec-h">
      <h2>Recipes</h2>
      <a href="/recipes">All {library.recipes.length} recipes <Icon name="arrowRight" /></a>
    </div>
    <RecipeBrowser client:load recipes={latest} owner={owner} extras={planning.shopping} searchable={false} />

    {
      library.meals.length > 0 && (
        <>
          <div class="as-sec-h">
            <h2>Meals</h2>
            <a href="/meals">
              All meals <Icon name="arrowRight" />
            </a>
          </div>
          <div class="as-tiles">
            {library.meals.slice(0, 4).map((meal) => (
              <MealCard meal={meal} recipesById={recipesById} />
            ))}
          </div>
        </>
      )
    }
  </div>
</SiteLayout>
