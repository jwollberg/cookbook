---
import SiteLayout from "../layouts/SiteLayout.astro";
import ShoppingList from "../components/ShoppingList";
import { loadKitchen, viewerToday } from "../lib/server/page";

const { library, planning, kitchen, owner } = await loadKitchen(Astro.locals);
---

<SiteLayout title="Shopping list" description="Your one list: the week's plan, anything added directly, grouped by aisle.">
  <div class="as-main">
    <header class="as-head">
      <div>
        <h1>Shopping list</h1>
        <p>{kitchen}: the week's plan and anything you add, grouped by aisle.</p>
      </div>
    </header>

    <ShoppingList
      client:load
      owner={owner}
      ingredients={library.ingredients}
      recipes={library.recipes}
      meals={library.meals}
      plans={planning.plans}
      pantry={planning.pantry}
      extras={planning.shopping}
      ticked={planning.ticked}
      today={viewerToday(Astro.locals)}
    />
  </div>
</SiteLayout>
