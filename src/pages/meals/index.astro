---
import SiteLayout from "../../layouts/SiteLayout.astro";
import MealCard from "../../components/MealCard.astro";
import { loadKitchen } from "../../lib/server/page";

const { library, recipesById } = await loadKitchen(Astro.locals);
---

<SiteLayout title="Meals" description="Recipes grouped into meals: a main, its sides, and everything else on the table.">
  <div class="as-main">
    <header class="as-head">
      <div>
        <h1>Meals</h1>
        <p>Recipes that go together: a main, its sides and everything else on the table.</p>
      </div>
    </header>

    {
      library.meals.length === 0 ? (
        <div class="empty">
          <p>No meals yet.</p>
        </div>
      ) : (
        <div class="as-tiles">
          {library.meals.map((meal) => (
            <MealCard meal={meal} recipesById={recipesById} />
          ))}
        </div>
      )
    }
  </div>
</SiteLayout>
