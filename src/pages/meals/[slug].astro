---
import SiteLayout from "../../layouts/SiteLayout.astro";
import AddDish from "../../components/AddDish";
import Icon from "../../components/Icon";
import { loadKitchen } from "../../lib/server/page";
import { formatMinutes, mealImages, mealMinutes } from "../../lib/format";
import { buildShoppingList, type ResolvedDish } from "../../lib/shopping";
import type { Role } from "../../lib/schema";

const { library, planning, owner, recipesById, ingredientsById } = await loadKitchen(Astro.locals);
const meal = library.meals.find((m) => m.id === Astro.params.slug);
if (!meal) return Astro.rewrite("/404");

const components = meal.components.flatMap((component) => {
  const recipe = recipesById.get(component.recipeId);
  return recipe ? [{ component, recipe }] : [];
});

const ROLE_ORDER: Role[] = ["starter", "main", "side", "sauce", "dessert", "drink"];
const ordered = [...components].sort(
  (a, b) => ROLE_ORDER.indexOf(a.component.role) - ROLE_ORDER.indexOf(b.component.role),
);

// Everything the meal needs, in one aggregated list. Staples are included
// here — on a "can I cook this tonight?" page you do want to see the salt.
const dishes: ResolvedDish[] = components.map(({ component, recipe }) => ({
  recipe,
  servings: component.servingsOverride,
}));
const shopping = buildShoppingList(dishes, ingredientsById, { includeStaples: true });

const totalActive = components.reduce((n, c) => n + c.recipe.prepMin + c.recipe.cookMin, 0);
const longest = mealMinutes(meal, recipesById);
const images = mealImages(meal, recipesById).slice(0, 4);
---

<SiteLayout title={meal.name} description={meal.description}>
  <div class="as-main">
    <a class="as-back" href="/meals"><Icon name="chevronLeft" /> Meals</a>
    <header class="as-head">
      <div>
        <h1>{meal.name}</h1>
        <p>{ordered.map(({ recipe }) => recipe.title).join(" · ")}</p>
      </div>
    </header>

    <div class="recipe-top as-card">
      <figure class="recipe-photo">
        {
          images.length > 1 ? (
            <div class={`collage collage-${images.length}`}>
              {images.map((src) => (
                <img src={src} alt="" />
              ))}
            </div>
          ) : images.length === 1 ? (
            <img src={images[0]} alt="" />
          ) : (
            <div class="no-photo">
              <Icon name="cloche" />
            </div>
          )
        }
      </figure>

      <div class="recipe-intro">
        {meal.description && <p class="lede">{meal.description}</p>}
        <div class="stats">
          <div class="stat">
            <span class="label">Dishes</span>
            <span class="stat-value">{components.length}</span>
          </div>
          {
            formatMinutes(longest) && (
              <div class="stat">
                <span class="label">Start to table</span>
                <span class="stat-value">About {formatMinutes(longest)}</span>
              </div>
            )
          }
        </div>
        {
          totalActive > longest && (
            <p class="small muted">
              {formatMinutes(totalActive)} of work in total, but the dishes overlap — follow the game plan
              and it all lands in about {formatMinutes(longest)}.
            </p>
          )
        }
        <AddDish
          client:load
          mealId={meal.id}
          title={meal.name}
          owner={owner}
          extras={planning.shopping}
        />
      </div>
    </div>

    <section>
      <div class="as-sec-h"><h2>On the table</h2></div>
      <div class="as-tiles">
        {
          ordered.map(({ component, recipe }) => (
            <article class="as-tile rcard" data-recipe={recipe.id}>
              <div class="as-tile-media rcard-media">
                {recipe.image ? (
                  <img src={recipe.image} alt="" loading="lazy" />
                ) : (
                  <div class="no-photo">
                    <Icon name="pot" />
                  </div>
                )}
                <span class="rcard-tag">{component.role}</span>
              </div>
              <div class="as-tile-body">
                <a class="rcard-link" href={`/recipes/${recipe.id}`}>
                  <h3>{recipe.title}</h3>
                </a>
                <div class="rcard-meta">
                  <span>
                    <Icon name="users" />
                    Serves {component.servingsOverride ?? recipe.servings}
                  </span>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      meal.timeline.length > 0 && (
        <section>
          <div class="as-sec-h"><h2>Game plan</h2></div>
          <ol class="timeline as-card as-pad">
            {meal.timeline.map((step, i) => {
              const recipe = step.recipeId ? recipesById.get(step.recipeId) : undefined;
              return (
                <li>
                  <span class="step-n">{i + 1}</span>
                  <div class="step-body">
                    {step.heading && <strong>{step.heading}</strong>}
                    {step.text}
                    {recipe && (
                      <div style="margin-top: 8px;">
                        <a class="chip" href={`/recipes/${recipe.id}`}>
                          {recipe.title}
                        </a>
                      </div>
                    )}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      )
    }

    <section>
      <div class="as-sec-h"><h2>Everything you need</h2></div>
      <div class="panel panel-pad" style="columns: 300px 2; column-gap: 40px;">
        {
          shopping.groups.map((group) => (
            <div class="aisle" style={`--aisle: var(--aisle-${group.aisle}); break-inside: avoid;`}>
              <div class="aisle-head">
                <span class="aisle-dot" />
                <span class="aisle-name">{group.aisle}</span>
              </div>
              <ul class="ing-list">
                {group.lines.map((line) => (
                  <li class="ing-row">
                    <span class="ing-qty">{line.parts.map((p) => p.text).join(" + ")}</span>
                    <span class="ing-name">{line.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      {
        shopping.splitLines.length > 0 && (
          <p class="small muted" style="margin-top: 12px;">
            {shopping.splitLines.length} ingredient{shopping.splitLines.length === 1 ? " is" : "s are"} listed in
            more than one unit because a conversion factor is missing — shown separately rather than guessed.
          </p>
        )
      }
    </section>
  </div>
</SiteLayout>
