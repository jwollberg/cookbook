---
import SiteLayout from "../../layouts/SiteLayout.astro";
import RecipeEditor from "../../components/RecipeEditor";
import Icon from "../../components/Icon";
import { claudeReady } from "../../lib/server/claude";
import { loadLibrary } from "../../lib/server/db";

// One page serves every recipe, reading ?id=. With no id it creates one.
const library = await loadLibrary(Astro.locals.runtime.env.DB);
const id = Astro.url.searchParams.get("id");
const recipe = id ? (library.recipes.find((r) => r.id === id) ?? null) : null;
if (id && !recipe) return Astro.rewrite("/404");
---

<SiteLayout title={recipe ? `Edit ${recipe.title}` : "New recipe"} description="Add or edit a recipe.">
  <div class="as-main">
    <a class="as-back" href="/edit"><Icon name="chevronLeft" /> Edit recipes</a>
    <header class="as-head">
      <div>
        <h1>{recipe ? recipe.title : "New recipe"}</h1>
      </div>
    </header>

    <RecipeEditor
      client:load
      initial={recipe}
      ingredients={library.ingredients}
      takenIds={library.recipes.map((r) => r.id)}
      aiReady={!recipe && claudeReady(Astro.locals.runtime.env)}
    />
  </div>
</SiteLayout>
