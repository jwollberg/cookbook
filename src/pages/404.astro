---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon";
---

<SiteLayout title="Not found">
  <div class="as-main">
    <header class="as-head">
      <div>
        <h1>That page is not on the menu</h1>
        <p>It may have been renamed or deleted, or the link was mistyped.</p>
      </div>
    </header>
    <div class="actions">
      <a class="btn btn-primary" href="/recipes"><Icon name="book" /> Browse recipes</a>
      <a class="btn" href="/">Home</a>
    </div>
  </div>
</SiteLayout>
