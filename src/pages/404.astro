---
import SiteLayout from "../layouts/SiteLayout.astro";
import Icon from "../components/Icon";
---

<SiteLayout title="Not found">
  <div class="wrap">
    <div class="page-head">
      <div>
        <span class="eyebrow">404</span>
        <h1>That page is not on the menu.</h1>
        <p class="lede">It may have been renamed or deleted, or the link was mistyped.</p>
        <div class="actions" style="margin-top: 10px;">
          <a class="btn btn-primary" href="/recipes"><Icon name="book" /> Browse recipes</a>
          <a class="btn" href="/">Home</a>
        </div>
      </div>
    </div>
  </div>
</SiteLayout>
