---
import SiteLayout from "../layouts/SiteLayout.astro";
import CookSheet from "../components/CookSheet";
import Icon from "../components/Icon";
import { loadKitchen, viewerToday } from "../lib/server/page";
import { entryCount, resolvePlan } from "../lib/plans";
import { formatRange } from "../lib/dates";

const { planning, kitchen, recipesById, mealsById, ingredientsById } = await loadKitchen(Astro.locals);
const today = viewerToday(Astro.locals);
const plan = resolvePlan(planning.plans, Astro.url.searchParams.get("plan") ?? undefined, today);
const others = planning.plans.filter((p) => entryCount(p) > 0 && p.id !== plan?.id).slice(0, 6);
---

<SiteLayout title="Cooking sheet" description="Every dish in the plan, in order, with quantities at the servings you planned.">
  <div class="wrap">
    <header class="page-head">
      <div>
        <span class="eyebrow">{kitchen}</span>
        <h1>Cooking sheet</h1>
      </div>
      <div class="actions no-print">
        <a class="btn btn-sm" href={plan ? `/plan?week=${plan.days[0].date}` : "/plan"}>
          <Icon name="calendar" /> Plan
        </a>
        <a class="btn btn-sm" href="/shopping"><Icon name="bag" /> Shopping list</a>
        <button class="btn btn-sm btn-icon" aria-label="Print" onclick="window.print()">
          <Icon name="printer" />
        </button>
      </div>
    </header>

    {
      others.length > 0 && (
        <div class="chips no-print" style="margin-bottom: 28px;">
          <span class="small muted" style="align-self: center;">
            Other weeks:
          </span>
          {others.map((p) => (
            <a class="chip" href={`/cook?plan=${p.id}`}>
              {formatRange(p.days[0].date, p.days[p.days.length - 1].date)}
            </a>
          ))}
        </div>
      )
    }

    {
      plan && entryCount(plan) > 0 ? (
        <CookSheet plan={plan} recipesById={recipesById} mealsById={mealsById} ingredientsById={ingredientsById} />
      ) : (
        <div class="empty">
          <p>Nothing to cook yet.</p>
          <a class="btn btn-primary" href="/plan">
            <Icon name="calendar" /> Plan the week
          </a>
        </div>
      )
    }
  </div>
</SiteLayout>
