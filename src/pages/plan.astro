---
import SiteLayout from "../layouts/SiteLayout.astro";
import Planner from "../components/Planner";
---

<SiteLayout
  title="Plan — Cookbook"
  description="Build a weekly meal plan from meals and recipes, then generate a cooking sheet and shopping list."
  wide
>
  <div class="wrap">
    <section style="padding-block: 40px 22px;">
      <p class="lbl">The week</p>
      <h1 style="margin-top: 10px;">Plan</h1>
      <p style="max-width: 58ch; margin: 14px 0 0; color: var(--ink-2);">
        Drag meals and recipes onto a day. Everything downstream — the cooking sheet and the
        shopping list — is generated from what lands here.
      </p>
    </section>

    {/* client:only — the working plan lives in localStorage. */}
    <Planner client:only="react" />

    <div style="height: 56px;"></div>
  </div>
</SiteLayout>
