---
import SiteLayout from "../layouts/SiteLayout.astro";
import Planner, { type PlannerMeal, type PlannerRecipe } from "../components/Planner";
import { loadKitchen, viewerToday } from "../lib/server/page";
import { mealImages } from "../lib/format";
import { mondayOf } from "../lib/plans";

const { library, planning, household, recipesById } = await loadKitchen(Astro.locals);
const today = viewerToday(Astro.locals);
const requested = Astro.url.searchParams.get("week");
const monday = mondayOf(requested && /^\d{4}-\d{2}-\d{2}$/.test(requested) ? requested : today);

// Only what the planner shows crosses to the browser.
const recipes: PlannerRecipe[] = library.recipes.map((r) => ({
  id: r.id,
  title: r.title,
  servings: r.servings,
  image: r.image,
}));
const meals: PlannerMeal[] = library.meals.map((m) => ({
  id: m.id,
  name: m.name,
  dishes: m.components.length,
  image: mealImages(m, recipesById)[0],
}));
---

<SiteLayout title="Plan" description="Plan the household's week, then cook and shop from it.">
  <div class="wrap">
    <header class="page-head">
      <div>
        <span class="eyebrow">{household.name}</span>
        <h1>Plan the week</h1>
        <p class="lede">
          Drag meals and recipes onto a day. The cooking sheet and the shopping list follow whatever
          lands here, and it saves itself.
        </p>
      </div>
    </header>

    <Planner
      client:load
      householdId={household.id}
      householdName={household.name}
      plans={planning.plans}
      recipes={recipes}
      meals={meals}
      today={today}
      monday={monday}
    />
  </div>
</SiteLayout>
