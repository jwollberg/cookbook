---
import SiteLayout from "../../layouts/SiteLayout.astro";
import RecipeBrowser, { type RecipeCard } from "../../components/RecipeBrowser";
import { loadRecipes, collectTags, formatMinutes, activeMinutes } from "../../lib/data.server";

const recipes = loadRecipes();
const tags = collectTags(recipes);

const cards: RecipeCard[] = recipes.map((r) => ({
  id: r.id,
  title: r.title,
  subtitle: r.subtitle,
  description: r.description,
  image: r.image,
  tags: r.tags,
  servings: r.servings,
  timeLabel: formatMinutes(activeMinutes(r)),
}));
---

<SiteLayout
  title="Recipes — Cookbook"
  description="Every recipe in the cookbook, searchable and filterable by tag."
>
  <section style="padding-block: 44px 8px;">
    <p class="lbl">The collection</p>
    <h1 style="margin-top: 10px;">Recipes</h1>
    <p style="max-width: 54ch; margin: 16px 0 28px; color: var(--ink-2);">
      {recipes.length} recipe{recipes.length === 1 ? "" : "s"}. Ingredients are canonical records,
      so quantities add up correctly once these are composed into meals and plans.
    </p>
  </section>

  {/* Rendered server-side too, so the full list still works with JS off. */}
  <RecipeBrowser client:load recipes={cards} tags={tags} />

  <div style="height: 40px;"></div>
</SiteLayout>
