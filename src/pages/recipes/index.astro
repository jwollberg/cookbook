---
import SiteLayout from "../../layouts/SiteLayout.astro";
import RecipeBrowser from "../../components/RecipeBrowser";
import Icon from "../../components/Icon";
import { loadKitchen } from "../../lib/server/page";
import { collectTags, recipeCard } from "../../lib/format";

const { library, planning, owner } = await loadKitchen(Astro.locals);
const tags = collectTags(library.recipes);
const query = Astro.url.searchParams.get("q") ?? "";
const tag = Astro.url.searchParams.get("tag");
---

<SiteLayout title="Recipes" description="Every recipe in the kitchen, searchable and filterable by tag.">
  <div class="wrap">
    <header class="page-head">
      <div>
        <h1>Recipes</h1>
      </div>
      <a class="btn" href="/edit/recipe"><Icon name="plus" /> New recipe</a>
    </header>

    <RecipeBrowser
      client:load
      recipes={library.recipes.map(recipeCard)}
      tags={tags}
      owner={owner}
      extras={planning.shopping}
      initialQuery={query}
      initialTags={tag && tags.includes(tag) ? [tag] : []}
    />
  </div>
</SiteLayout>
