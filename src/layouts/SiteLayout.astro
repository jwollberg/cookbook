---
/**
 * Kitchen's frame — the shared Atheos app shell (canonical copy in
 * C:\Projects\Atheos Home Apps\Home\app-shell): brand, nav,
 * app switcher, account, and the floating tab bar on phones.
 */
import "../styles/shell.css";
import "../styles/global.css";
import themeJs from "../lib/theme.js?raw";
import menuJs from "../lib/menu.js?raw";
import Icon from "../components/Icon";
import bundled from "../lib/apps.json";
import { appRegistry } from "../lib/server/apps";
import { SIGN_OUT_URL } from "../lib/server/access";
import { countList } from "../lib/server/db";
import { BASE, routePath, withBase } from "../lib/base";

// The app list is Home's (apps.ts): a change there reaches this switcher within a minute.
const registry = await appRegistry(Astro.locals.runtime.env, bundled);

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Recipes, meal plans, and a shopping list that adds itself up." } = Astro.props;

const { viewer } = Astro.locals;
const signedIn = Boolean(viewer);
const listCount = signedIn ? await countList(Astro.locals.runtime.env.DB, viewer.id) : 0;

// Astro.url.pathname keeps a trailing slash on directory routes; strip it so
// "/recipes/" still matches "/recipes" for aria-current. It's the route's path, without the
// folder this build may be served from (lib/base.ts), as nav's hrefs are.
const path = routePath(Astro.url.pathname).replace(/\/+$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));

const nav = [
  { href: "/recipes", label: "Recipes", icon: "book" },
  { href: "/meals", label: "Meals", icon: "cloche" },
  { href: "/plan", label: "Plan", icon: "calendar" },
  { href: "/shopping", label: "Shopping list", short: "List", icon: "bag", badge: true },
] as const;

const who = viewer?.name ?? viewer?.email ?? "Signed in";
const initial = who.trim().charAt(0).toUpperCase();
const pageTitle = title === "Hestia" ? title : `${title} · Hestia`;

// The app switcher shows only the apps this person may open (Home's People list).
const viewerApps = Astro.locals.apps ?? [];
const apps = registry.apps.filter((a) => a.id === "home" || viewerApps.includes(a.id));
const self = registry.apps.find((a) => a.id === "kitchen")!;
const svg = (inner: string) =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f4f5f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0e14" media="(prefers-color-scheme: dark)" />
    <title>{pageTitle}</title>
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <!-- The Home Screen icon (Home's app-shell/icons.mjs): an iPhone draws a letter without it. -->
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta name="apple-mobile-web-app-title" content="Hestia" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400..750&display=swap"
    />
    <!-- Light or dark, as chosen in any Atheos app's account menu (app-shell/theme.js). -->
    <script is:inline set:html={themeJs} />
    <!-- The right-click menu and keyboard shortcuts every Atheos app shares (app-shell/menu.js). -->
    <script is:inline set:html={menuJs} />
  </head>
  <body class={signedIn ? "as-body as-has-tabbar" : "as-body"}>
    <a class="skip" href="#main">Skip to content</a>

    {
      signedIn && (
        <header class="as-top">
          <div class="as-top-in">
            <a class="as-brand" href={withBase("/")}>
              <span class="as-mark" set:html={svg(self.icon)} />
              Hestia
            </a>

            <nav class="as-nav" aria-label="Primary">
              {nav.map((item) => (
                <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
                  {item.label}
                  {"badge" in item && (
                    <span class="count-badge" data-list-count hidden={listCount === 0}>
                      {listCount}
                    </span>
                  )}
                </a>
              ))}
            </nav>

            <div class="as-end">
              <details class="as-switch" data-menu>
                <summary class="as-round" aria-label="Switch app" set:html={svg(registry.switcherIcon)} />
                <nav class="as-menu" aria-label="Apps">
                  {apps.map((a) => (
                    <a
                      class="as-app"
                      href={a.url}
                      aria-current={a.id === "kitchen" ? "true" : undefined}
                      style={`--c:${a.light.app};--cd:${a.dark.app}`}
                    >
                      <span class="as-mark" set:html={svg(a.icon)} />
                      <span>
                        <b>{a.name}</b>
                        <small>{a.blurb}</small>
                      </span>
                    </a>
                  ))}
                </nav>
              </details>

              {/* The shared shell's account menu (app-shell/README.md): same in every app. */}
              <details class="as-me" data-menu>
                <summary class="as-round as-avatar" aria-label={`Account: ${who}`}>
                  {viewer.picture ? (
                    <img src={viewer.picture} alt="" referrerpolicy="no-referrer" width="38" height="38" />
                  ) : (
                    initial
                  )}
                </summary>
                <nav class="as-menu" aria-label="Account">
                  <div class="as-me-head">
                    <span class="as-round as-avatar" aria-hidden="true">
                      {viewer.picture ? (
                        <img src={viewer.picture} alt="" referrerpolicy="no-referrer" width="38" height="38" />
                      ) : (
                        initial
                      )}
                    </span>
                    <span>
                      <b>{who}</b>
                      {who !== viewer.email && <small>{viewer.email}</small>}
                    </span>
                  </div>
                  <div class="as-theme" role="group" aria-label="Theme"><span>Theme</span><div><button type="button" data-as-theme="auto" aria-pressed="false">Auto</button><button type="button" data-as-theme="light" aria-pressed="false">Light</button><button type="button" data-as-theme="dark" aria-pressed="false">Dark</button></div></div>
                  <a class="as-item" href={withBase("/edit")}>
                    <Icon name="pencil" />
                    <span>Edit recipes</span>
                  </a>
                  <a class="as-item" href={withBase("/cook")}>
                    <Icon name="pot" />
                    <span>Cooking sheet</span>
                  </a>
                  <a class="as-item" href={withBase("/credits")}>
                    <Icon name="camera" />
                    <span>Photo credits</span>
                  </a>
                  <div class="as-sep" />
                  <a class="as-item" href={SIGN_OUT_URL}>
                    <Fragment set:html={svg(registry.accountIcons.switch)} />
                    <span>Switch account</span>
                  </a>
                  <a class="as-item" href={SIGN_OUT_URL}>
                    <Fragment set:html={svg(registry.accountIcons.signOut)} />
                    <span>Sign out</span>
                  </a>
                </nav>
              </details>
            </div>
          </div>
        </header>
      )
    }

    <main id="main">
      <slot />
    </main>

    {
      signedIn && (
        <nav class="as-tabbar" aria-label="Primary">
          <a href={withBase("/")} aria-current={isActive("/") ? "page" : undefined}>
            <Icon name="pot" />
            Today
          </a>
          {nav.map((item) => (
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
              <Icon name={item.icon} />
              {"short" in item ? item.short : item.label}
              {"badge" in item && (
                <span class="count-badge" data-list-count hidden={listCount === 0}>
                  {listCount}
                </span>
              )}
            </a>
          ))}
        </nav>
      )
    }

    <script is:inline define:vars={{ base: BASE }}>
      // Menus are <details>: they open with no JavaScript at all. This only
      // closes them on an outside click or Escape, like a menu should — and
      // one menu opening closes the others.
      document.addEventListener("click", (event) => {
        document.querySelectorAll("details[data-menu][open]").forEach((menu) => {
          if (!menu.contains(event.target)) menu.removeAttribute("open");
        });
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        document.querySelectorAll("details[data-menu][open]").forEach((menu) => menu.removeAttribute("open"));
      });
      // Islands announce list changes; keep both badges in step.
      window.addEventListener("kitchen:list-changed", (event) => {
        const count = event.detail?.count ?? 0;
        document.querySelectorAll("[data-list-count]").forEach((badge) => {
          badge.textContent = String(count);
          badge.hidden = count === 0;
        });
      });

      // The right-click menu's Hestia items for the plain (server-rendered) cards and pages.
      // The islands add their own: a recipe card's list button, the planner, the shopping list.
      (() => {
        const menu = window.atheosMenu;
        if (!menu) return;
        // Tabler Icons (MIT), the paths Icon.tsx draws, for the islands' menu items too.
        Object.assign(menu.icons, {
          pencil: '<path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"/><path d="M13.5 6.5l4 4"/>',
          bag: '<path d="M6.331 8h11.339a2 2 0 0 1 1.977 2.304l-1.255 8.152a3 3 0 0 1 -2.966 2.544h-6.852a3 3 0 0 1 -2.965 -2.544l-1.255 -8.152a2 2 0 0 1 1.977 -2.304"/><path d="M9 11v-5a3 3 0 0 1 6 0v5"/>',
          calendar: '<path d="M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12"/><path d="M16 3v4"/><path d="M8 3v4"/><path d="M4 11h16"/>',
          plus: '<path d="M12 5l0 14"/><path d="M5 12l14 0"/>',
          minus: '<path d="M5 12l14 0"/>',
          trash: '<path d="M4 7l16 0"/><path d="M10 11l0 6"/><path d="M14 11l0 6"/><path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"/><path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"/>',
          printer: '<path d="M17 17h2a2 2 0 0 0 2 -2v-4a2 2 0 0 0 -2 -2h-14a2 2 0 0 0 -2 2v4a2 2 0 0 0 2 2h2"/><path d="M17 9v-4a2 2 0 0 0 -2 -2h-6a2 2 0 0 0 -2 2v4"/><path d="M7 15a2 2 0 0 1 2 -2h6a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2z"/>',
        });
        // The folder this build is served from ("" or "/hestia", lib/base.ts): the paths below are the routes'.
        const at = (path) => base + path;
        const link = (path) => new URL(path, location.origin).href;
        // A recipe card a page drew (a meal's dishes); the recipe browser's cards add the list.
        // Right-clicking a card's title link already offers its own "Copy link".
        const copyItem = (ctx, path) =>
          ctx.link?.pathname !== path && { label: "Copy link", icon: "link", run: () => menu.copy(link(path), "Link copied") };
        menu.add("[data-recipe]", (el, ctx) => {
          const id = el.dataset.recipe;
          return [
            { label: "Open recipe", href: at(`/recipes/${id}`) },
            { label: "Edit recipe", icon: "pencil", href: at(`/edit/recipe?id=${encodeURIComponent(id)}`) },
            copyItem(ctx, at(`/recipes/${id}`)),
          ];
        });
        menu.add("[data-meal]", (el, ctx) => [
          { label: "Open meal", href: at(`/meals/${el.dataset.meal}`) },
          copyItem(ctx, at(`/meals/${el.dataset.meal}`)),
        ]);
        // A recipe's own page: its Edit button, and the list button under its ingredients.
        menu.add("[data-recipe-page]", (el) => {
          const add = document.querySelector("[data-list-add]");
          return [
            { label: "Edit recipe", icon: "pencil", keys: "E", href: at(`/edit/recipe?id=${encodeURIComponent(el.dataset.recipePage)}`) },
            add && { label: add.textContent.trim(), icon: "bag", disabled: add.disabled, run: () => add.click() },
          ];
        });
        menu.key("e", "Edit this recipe", () => document.querySelector("[data-recipe-page] [data-edit]")?.click(), {
          group: "Recipe",
          when: () => !!document.querySelector("[data-recipe-page]"),
        });
        menu.key("n", "New recipe", () => document.querySelector("[data-new-recipe]")?.click(), {
          group: "Recipes",
          when: () => !!document.querySelector("[data-new-recipe]"),
        });
        menu.search("Search recipes for", (q) => location.assign(at(`/recipes?q=${encodeURIComponent(q)}`)));
      })();
    </script>
  </body>
</html>
