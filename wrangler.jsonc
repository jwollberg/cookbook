{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitchen",
  // Astro's Cloudflare adapter builds the Worker into dist/_worker.js; the rest
  // of dist/ is static assets (.assetsignore keeps the Worker itself out).
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Static files are served straight from the edge and never reach the
  // Worker, so they skip the sign-in check. Nothing private may be a static
  // file: every page with data in it is rendered by the Worker, behind auth.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "routes": [{ "pattern": "kitchen.atheosstudios.com", "custom_domain": true }],
  // One address only: Cloudflare Access guards this hostname, and a workers.dev
  // or preview URL would not be behind it (the Worker would refuse, too).
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kitchen",
      "database_id": "64201a80-8066-4c30-be0a-d712f6d031a7",
      "migrations_dir": "./migrations"
    }
  ],

  // Photos uploaded from the recipe editor. Served through the Worker at
  // /photos/*, so they sit behind sign-in like everything else.
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "kitchen-photos"
    }
  ],

  "vars": {
    "APP_URL": "https://kitchen.atheosstudios.com"
  }

  // Secrets (`wrangler secret put <NAME>`), none of them sensitive keys:
  //   ACCESS_TEAM_DOMAIN    atheosstudios.cloudflareaccess.com (Cloudflare Access does the sign-in)
  //   ACCESS_AUD            the Kitchen Access application's audience tag
  //   ALLOWED_EMAILS        comma-separated; the only accounts that may use Kitchen
  //   OWNER_EMAILS          who sees every Atheos app in the switcher (Josh)
}
