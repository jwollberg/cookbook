{
  "name": "kitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "npm run build && wrangler dev --port 8787",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "ci": "npm test && npm run build",
    "deploy": "npm run ci && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kitchen --local",
    "db:migrate:remote": "wrangler d1 migrations apply kitchen --remote",
    "db:seed:local": "node scripts/seed.mjs && wrangler d1 execute kitchen --local --file scripts/seed.sql",
    "db:seed:remote": "node scripts/seed.mjs && wrangler d1 execute kitchen --remote --file scripts/seed.sql"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^4.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^5.15.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.145.0"
  }
}
